{
  "rules": {
    // Club database (deuceandsmash-club). Paste into Firebase console → Realtime Database → Rules → Publish.
    //
    // STAFF  = signed-in Google account listed under /admins (email with "." replaced by ","): read/write everything.
    // PUBLIC = tournaments + match scores (scoreboards).
    // MEMBER = signed-in SmashDex user whose login is linked to a member under /links/{uid}.

    ".read":  "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",
    ".write": "auth != null && auth.token.email_verified == true && root.child('admins').child(auth.token.email.toLowerCase().replace('.', ',')).val() === true",

    "admins": {
      "$emailKey": {
        ".read": "auth != null && auth.token.email_verified == true && $emailKey === auth.token.email.toLowerCase().replace('.', ',')"
      }
    },

    "tournaments":     { ".read": true },
    "openPlayMatches": { ".read": true },

    // Which member a login belongs to (written by staff when approving a request)
    "links": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    // A not-yet-linked user asks staff to link them to their Dex record
    "linkRequests": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !root.child('links').child($uid).exists()",
        ".validate": "!newData.exists() || newData.hasChildren(['name', 'at'])"
      }
    },

    // Member-safe profile (no phone/email/notes). Readable by any signed-in SmashDex user.
    "profiles": {
      ".read": "auth != null",
      "$mid": {
        "name":  { ".write": "auth != null && root.child('links').child(auth.uid).val() === $mid", ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
        "prefs": { ".write": "auth != null && root.child('links').child(auth.uid).val() === $mid" },
        "seenHonours": { ".write": "auth != null && root.child('links').child(auth.uid).val() === $mid" }
      }
    },

    // Private member record: the linked member can read/edit only their own contact fields
    "members": {
      "$mid": {
        "$field": {
          ".read":  "auth != null && root.child('links').child(auth.uid).val() === $mid && ($field === 'name' || $field === 'fullName' || $field === 'phone' || $field === 'email' || $field === 'dexNo')",
          ".write": "auth != null && root.child('links').child(auth.uid).val() === $mid && ($field === 'name' || $field === 'fullName' || $field === 'phone' || $field === 'email')"
        }
      }
    },

    // Manual rating changes. A member may lower their own rating exactly once ("self"); anything else is staff-only.
    "adjustments": {
      ".read": "auth != null",
      "$mid": {
        "self": {
          ".write": "auth != null && root.child('links').child(auth.uid).val() === $mid && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['from', 'to', 'date', 'at']) && newData.child('to').isNumber() && newData.child('from').isNumber() && newData.child('to').val() >= 0 && newData.child('to').val() < newData.child('from').val()"
        }
      }
    },

    // Club list for score entry (staff curate; members can suggest in a later release)
    "clubs": { ".read": "auth != null" },

    // Usage analytics: write-only counters for members (each write may only add 1); staff read them in /admin
    "analytics": {
      "members": {
        "$mid": {
          "visits":    { ".write": "auth != null && root.child('links').child(auth.uid).val() === $mid", ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1" },
          "lastSeen":  { ".write": "auth != null && root.child('links').child(auth.uid).val() === $mid", ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
          "firstSeen": { ".write": "auth != null && root.child('links').child(auth.uid).val() === $mid && !data.exists()", ".validate": "newData.isNumber()" },
          "events": { "$ev": { ".write": "auth != null && root.child('links').child(auth.uid).val() === $mid", ".validate": "$ev.length <= 40 && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1" } }
        }
      },
      "daily": {
        "$day": {
          "visits": { ".write": "auth != null", ".validate": "$day.length === 10 && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1" },
          "users":  { "$mid": { ".write": "auth != null && root.child('links').child(auth.uid).val() === $mid", ".validate": "newData.val() === true" } },
          "events": { "$ev": { ".write": "auth != null", ".validate": "$day.length === 10 && $ev.length <= 40 && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1" } }
        }
      }
    }
  }
}
